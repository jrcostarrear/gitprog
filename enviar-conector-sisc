#!/usr/bin/env bash
set -euo pipefail

MODO="teste"
URL="https://costarrear.com/gitconectores/upload.php"
LOGIN="${SISC_LOGIN:-}"
PACOTE=""
VALIDAR_LOCAL=1
CURL_INSECURE=0

uso() {
  cat <<'TXT'
Uso:
  ./enviar-conector-sisc --modo=teste --pacote=dist/conector-nome-1.0.0.tar.gz --login=<login>
  ./enviar-conector-sisc --modo=aprovacao --pacote=dist/conector-nome-1.0.0.tar.gz --login=<login>

Opcoes:
  --modo=teste        Envia para homologacao e instala/sobrescreve somente no testesis.
  --modo=aprovacao    Solicita validacao oficial; se passar, servidor integra ao siscore.
  --pacote=ARQ        Pacote .tar.gz, .tgz ou .zip gerado pelo programador.
  --login=NOME        Login de teste fornecido pelo operador SISC.
  --url=URL           Endpoint de upload. Padrao: https://costarrear.com/gitconectores/upload.php
  --sem-validar-local Nao roda ./validar-conector antes de enviar em modo aprovacao.
  --insecure           Somente para homologacao local com certificado TLS autoassinado.

Token:
  Crie localmente token-externo/<login>.txt com o token recebido fora do pacote.
  Nunca coloque token no manifesto, handler, manual ou pacote do conector.
TXT
}

for arg in "$@"; do
  case "$arg" in
    --modo=*) MODO="${arg#--modo=}" ;;
    --pacote=*) PACOTE="${arg#--pacote=}" ;;
    --login=*) LOGIN="${arg#--login=}" ;;
    --url=*) URL="${arg#--url=}" ;;
    --sem-validar-local) VALIDAR_LOCAL=0 ;;
    --insecure) CURL_INSECURE=1 ;;
    --ajuda|--help|-h) uso; exit 0 ;;
    *) echo "Argumento invalido: $arg" >&2; uso >&2; exit 2 ;;
  esac
done

if [[ "$MODO" != "teste" && "$MODO" != "aprovacao" ]]; then
  echo "Modo invalido. Use teste ou aprovacao." >&2; exit 2
fi
if [[ -z "$PACOTE" || ! -f "$PACOTE" ]]; then
  echo "Pacote ausente ou inexistente. Informe --pacote=dist/arquivo.tar.gz" >&2; exit 2
fi
if [[ -z "$LOGIN" || ! "$LOGIN" =~ ^[A-Za-z0-9._-]{1,128}$ ]]; then
  echo "Login invalido ou ausente. Informe --login=<login>." >&2; exit 2
fi

TOKEN_FILE="token-externo/${LOGIN}.txt"
if [[ ! -r "$TOKEN_FILE" ]]; then
  echo "Token local nao encontrado: $TOKEN_FILE" >&2
  echo "Crie esse arquivo com o token de teste recebido fora do pacote." >&2
  exit 2
fi

TOKEN=""
while IFS= read -r linha || [[ -n "$linha" ]]; do
  linha="${linha//$'\r'/}"
  linha="${linha#${linha%%[![:space:]]*}}"
  linha="${linha%${linha##*[![:space:]]}}"
  [[ -z "$linha" || "${linha:0:1}" == "#" ]] && continue
  if [[ "$linha" == *"="* ]]; then TOKEN="${linha#*=}"
  elif [[ "$linha" == *":"* ]]; then TOKEN="${linha#*:}"
  else TOKEN="$linha"
  fi
  break
done < "$TOKEN_FILE"

if [[ ${#TOKEN} -lt 16 ]]; then
  echo "Token invalido em $TOKEN_FILE" >&2; exit 2
fi

if [[ "$MODO" == "aprovacao" && "$VALIDAR_LOCAL" -eq 1 ]]; then
  if [[ ! -x ./validar-conector ]]; then chmod +x ./validar-conector 2>/dev/null || true; fi
  echo "[local] rodando ./validar-conector antes do envio para aprovacao..." >&2
  ./validar-conector
fi

echo "[upload] enviando pacote em modo=$MODO para $URL" >&2
CURL_OPTS=(--fail --show-error --silent)
if [[ "$CURL_INSECURE" -eq 1 ]]; then CURL_OPTS+=(--insecure); fi
curl "${CURL_OPTS[@]}" \
  -X POST \
  -F "resposta=json" \
  -F "modo=$MODO" \
  -F "login=$LOGIN" \
  -F "token=$TOKEN" \
  -F "pacote=@${PACOTE}" \
  "$URL"
echo
